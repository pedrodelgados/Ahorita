# Copia este archivo a .env y completa con los datos de tu proyecto de Supabase
# (Project Settings > API en supabase.com)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Notificaciones push — genera tu propio par de claves con:
#   npx web-push generate-vapid-keys
# Pega aquí la "Public Key". La "Private Key" va como secret de Supabase
# (ver supabase/README.md), nunca en el frontend.
VITE_VAPID_PUBLIC_KEY=
